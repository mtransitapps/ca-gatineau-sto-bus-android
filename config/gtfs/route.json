    "direction_finder_enabled": true,
    "allow_non_descriptive_head_signs_until": {
        "79": "20240815"
    },
    "trip_headsign_remove_via": true,
    "trip_headsign_cleaners": [
        {
            "regex": "((^|\\W)(station|ston|sta)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2$4",
            "comment": "Remove station/ston/sta from trip headsigns"
        },
        {
            "regex": "((^|\\W)(c[é|e]gep gabrielle-roy|cegep gab\\.roy|cegep gab-roy|c[é|e]gep groy|c[é|e]gep g-roy|cegep g-roy|c[é|e]gep g\\.roy|cgp gabrielle-r|cgp groy|cgp g-roy|g-roy)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Cgp GRoy$4"
        },
        {
            "regex": "((^|\\W)(college|collège|collége)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Col$4"
        },
        {
            "regex": "((^|\\W)(col nf|col nouvelles frontieres|col nouvelles frontières)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Col NF$4"
        },
        {
            "regex": "((^|\\W)(c stjoseph)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Col St-Jo$4"
        },
        {
            "regex": "((^|\\W)(col stalex)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Col St-Alex$4"
        },
        {
            "regex": "((école secondaire|ecole secondaire|école sec|ecole sec|école|ecole|e)(\\.|\\s){1,2}(\\w+))",
            "ignore_case": true,
            "is_word": true,
            "replacement": "É $7"
        },
        {
            "regex": "grande-rivière|gr-rivière",
            "ignore_case": true,
            "is_word": true,
            "replacement": "Gr-Riv"
        },
        {
            "regex": "((^|\\W)(galeries aylmer|gal\\.aylmer)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Gal.Aylmer$4"
        },
        {
            "regex": "((^|\\W)(jardins lavigne|jlavigne)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2JLavigne$4"
        },
        {
            "regex": "((^|\\W)(des allumetti[è|e]res|allumetti[è|e]res|allum)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Allum$4"
        },
        {
            "regex": "((^|\\W)(c[ô|o]tes-des-neiges|coteneige)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Côtes-Des-Neiges$4"
        },
        {
            "regex": "((^|\\W)(pob|p-o-b|parc o bus|parc-o-bus)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2P-O-B$4"
        },
        {
            "regex": "((^|\\W)(place d'accueil|pl\\.accueil)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Pl.Accueil$4"
        },
        {
            "regex": "((^|\\W)(pr[e|é] tunney)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Pré-Tunney$4"
        },
        {
            "regex": "((^|\\W)(mus[e|é]e canadien de l'histoire)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2Musée de l'Histoire$4"
        },
        {
            "regex": "((^|\\W)(masson-angers)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2M-Angers$4"
        },
        {
            "regex": "mont-bleu",
            "ignore_case": true,
            "is_word": true,
            "replacement": "MontBleu"
        }
    ],
    "stop_name_cleaners": [
        {
            "regex": "(^(arriv[e|é]e|d[e|é]part)|[/\\-]?\\s*(arr[e|ê]t d'arriv[e|é]e|arriv[e|é]e|d[e|é]part)|( - temps d'attente)$)",
            "ignore_case": true
        },
        {
            "regex": "((arr[e|ê]t de courtoisie\\s*)(.*))",
            "ignore_case": true,
            "replacement": "$3 (Arrêt de Courtoisie)"
        },
        {
            "regex": "((^|\\W)(pob|p-o-b|parc o bus|parc-o-bus)(\\W|$))",
            "ignore_case": true,
            "replacement": "$2P-O-B$4"
        },
        {
            "regex": "((école secondaire|ecole secondaire|école sec|ecole sec|école|ecole|e)(\\.|\\s){1,2}(\\w+))",
            "ignore_case": true,
            "is_word": true,
            "replacement": "É $7"
        },
        {
            "regex": "(saint)",
            "ignore_case": true,
            "replacement": "St"
        },
        {
            "regex": "et",
            "is_word": true,
            "replacement": "&"
        }
    ]
}